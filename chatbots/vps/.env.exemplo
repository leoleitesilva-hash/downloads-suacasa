# Copie este arquivo para .env e preencha:  cp .env.exemplo .env
# NUNCA suba o .env preenchido pro GitHub.

# ---------- Domínios (crie 3 subdomínios apontando pro IP da VPS) ----------
EVOLUTION_DOMINIO=api.seudominio.com.br
TYPEBOT_BUILDER_DOMINIO=typebot.seudominio.com.br
TYPEBOT_VIEWER_DOMINIO=bot.seudominio.com.br

# ---------- Banco de dados ----------
POSTGRES_USER=admin
# Gere uma senha forte: openssl rand -hex 16
POSTGRES_PASSWORD=TROQUE_ESTA_SENHA

# ---------- Evolution API (WhatsApp) ----------
# Chave de acesso à API. Gere com: openssl rand -hex 16
EVOLUTION_API_KEY=TROQUE_ESTA_CHAVE

# ---------- Typebot ----------
# Segredo de criptografia (exatamente 32 caracteres). Gere com: openssl rand -hex 16
TYPEBOT_ENCRYPTION_SECRET=TROQUE_32_CARACTERES_EXATOS_AQUI
# Seu e-mail (será o admin do Typebot)
TYPEBOT_ADMIN_EMAIL=leoleitesilva@gmail.com

# ---------- SMTP (envio do link mágico de login do Typebot) ----------
# Pode usar Gmail com senha de app, Brevo (grátis), Resend, etc.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=leoleitesilva@gmail.com
SMTP_PASSWORD=SENHA_DE_APP_AQUI
SMTP_FROM="Sua Casa Mais Segura <leoleitesilva@gmail.com>"
